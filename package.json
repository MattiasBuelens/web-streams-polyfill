{
  "name": "web-streams-polyfill",
  "version": "4.5.1",
  "description": "Web Streams, based on the WHATWG spec reference implementation",
  "main": "dist/ponyfill.js",
  "module": "dist/ponyfill.mjs",
  "sideEffects": [
    "./dist/auto.js",
    "./dist/replace.js",
    "./dist/replace.es5.js"
  ],
  "types": "types/ponyfill.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/ponyfill.d.mts",
        "default": "./dist/ponyfill.mjs"
      },
      "require": {
        "types": "./types/ponyfill.d.ts",
        "default": "./dist/ponyfill.js"
      }
    },
    "./es5": {
      "import": {
        "types": "./types/ponyfill.d.mts",
        "default": "./dist/ponyfill.es5.mjs"
      },
      "require": {
        "types": "./types/ponyfill.d.ts",
        "default": "./dist/ponyfill.es5.js"
      }
    },
    "./subclass": {
      "import": {
        "types": "./types/subclass.d.mts",
        "default": "./dist/subclass.mjs"
      },
      "require": {
        "types": "./types/subclass.d.ts",
        "default": "./dist/subclass.js"
      }
    },
    "./auto": {
      "types": "./types/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./replace": {
      "types": "./types/replace.d.ts",
      "default": "./dist/replace.js"
    },
    "./replace/es5": {
      "types": "./types/replace.d.ts",
      "default": "./dist/replace.es5.js"
    },
    "./feature": {
      "types": "./types/feature/index.d.mts",
      "default": "./dist/feature/index.mjs"
    },
    "./feature/readable-stream-from": {
      "types": "./types/feature/readable-stream-from.d.mts",
      "default": "./dist/feature/readable-stream-from.mjs"
    },
    "./feature/async-iterator": {
      "types": "./types/feature/async-iterator.d.mts",
      "default": "./dist/feature/async-iterator.mjs"
    },
    "./feature/byob-read-min": {
      "types": "./types/feature/byob-read-min.d.mts",
      "default": "./dist/feature/byob-read-min.mjs"
    },
    "./feature/transformer-cancel": {
      "types": "./types/feature/transformer-cancel.d.mts",
      "default": "./dist/feature/transformer-cancel.mjs"
    },
    "./dist/*": "./dist/*",
    "./types/*": "./types/*",
    "./package": "./package.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test:types && npm run test:api && npm run test:unit && npm run test:wpt && npm run test:bundlers && npm run test:package",
    "test:wpt": "npm run test:wpt:node && npm run test:wpt:chromium && npm run test:wpt:firefox && npm run test:wpt:webkit",
    "test:wpt:node": "node --expose_gc ./test/wpt/node/run.mjs",
    "test:wpt:chromium": "node ./test/wpt/browser/run.mjs --browser chromium",
    "test:wpt:firefox": "node ./test/wpt/browser/run.mjs --browser firefox",
    "test:wpt:webkit": "node ./test/wpt/browser/run.mjs --browser webkit",
    "test:wpt:native": "npm run test:wpt:native:chromium && npm run test:wpt:native:firefox && npm run test:wpt:native:webkit && npm run test:wpt:native:node",
    "test:wpt:native:chromium": "node ./test/wpt/browser/run.mjs --native --browser chromium",
    "test:wpt:native:firefox": "node ./test/wpt/browser/run.mjs --native --browser firefox",
    "test:wpt:native:webkit": "node ./test/wpt/browser/run.mjs --native --browser webkit",
    "test:wpt:native:node": "node --expose_gc ./test/wpt/node/run.mjs --native",
    "test:wpt:patched": "npm run test:wpt:patched:chromium && npm run test:wpt:patched:firefox && npm run test:wpt:patched:webkit && npm run test:wpt:patched:node",
    "test:wpt:patched:chromium": "node ./test/wpt/browser/run.mjs --patched --browser chromium",
    "test:wpt:patched:firefox": "node ./test/wpt/browser/run.mjs --patched --browser firefox",
    "test:wpt:patched:webkit": "node ./test/wpt/browser/run.mjs --patched --browser webkit",
    "test:wpt:patched:node": "node --expose_gc ./test/wpt/node/run.mjs --patched",
    "test:wpt:patched-forced": "npm run test:wpt:patched-forced:chromium && npm run test:wpt:patched-forced:firefox && npm run test:wpt:patched-forced:webkit && npm run test:wpt:patched-forced:node",
    "test:wpt:patched-forced:chromium": "node ./test/wpt/browser/run.mjs --patched --force --browser chromium",
    "test:wpt:patched-forced:firefox": "node ./test/wpt/browser/run.mjs --patched --force --browser firefox",
    "test:wpt:patched-forced:webkit": "node ./test/wpt/browser/run.mjs --patched --force --browser webkit",
    "test:wpt:patched-forced:node": "node --expose_gc ./test/wpt/node/run.mjs --patched --force",
    "test:wpt:subclass": "npm run test:wpt:subclass:chromium && npm run test:wpt:subclass:firefox && npm run test:wpt:subclass:webkit && npm run test:wpt:subclass:node",
    "test:wpt:subclass:chromium": "node ./test/wpt/browser/run.mjs --subclass --browser chromium",
    "test:wpt:subclass:firefox": "node ./test/wpt/browser/run.mjs --subclass --browser firefox",
    "test:wpt:subclass:webkit": "node ./test/wpt/browser/run.mjs --subclass --browser webkit",
    "test:wpt:subclass:node": "node --expose_gc ./test/wpt/node/run.mjs --subclass",
    "test:bundlers": "npm run test:bundler:rolldown && npm run test:bundler:rollup && npm run test:bundler:webpack",
    "test:bundler:rolldown": "npm test --workspace=test/rolldown-test",
    "test:bundler:rollup": "npm test --workspace=test/rollup-test",
    "test:bundler:webpack": "npm test --workspace=test/webpack-test",
    "test:types": "tsc -p ./test/types/tsconfig.json",
    "test:api": "node ./scripts/check-api.mjs",
    "test:package": "publint --strict && attw --pack . --profile node16 --ignore-rules named-exports cjs-resolves-to-esm",
    "test:unit": "cd test/unit && node --test",
    "lint": "eslint \"*.mjs\" \"*.ts\" \"scripts/**/*.mjs\" \"src/**/*.ts\"",
    "build": "npm run build:prod",
    "build:prod": "rolldown -c rolldown.config.ts",
    "build:debug": "rolldown -c rolldown.config.ts --environment BUILD:debug",
    "build:watch": "rolldown -c rolldown.config.ts --watch --environment BUILD:debug",
    "accept:api": "node ./scripts/check-api.mjs --accept",
    "size": "node ./scripts/size.mjs",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "types"
  ],
  "engines": {
    "node": ">= 8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattiasBuelens/web-streams-polyfill.git"
  },
  "keywords": [
    "streams",
    "whatwg",
    "polyfill"
  ],
  "author": "Mattias Buelens <mattias@buelens.com>",
  "contributors": [
    "Diwank Singh <diwank.singh@gmail.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MattiasBuelens/web-streams-polyfill/issues"
  },
  "homepage": "https://github.com/MattiasBuelens/web-streams-polyfill#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.21",
    "@types/node": "~26.6.5",
    "acorn": "^8.19.0",
    "eslint": "^10.1.0",
    "eslint-scope": "^9.1.2",
    "globals": "^17.4.0",
    "micromatch": "^4.0.8",
    "minimist": "^1.2.8",
    "playwright": "^1.60.0",
    "publint": "^0.3.25",
    "rolldown": "^1.2.16",
    "rolldown-plugin-dts": "^0.29.0",
    "st": "^4.0.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "wpt-runner": "^7.0.0"
  },
  "workspaces": [
    "test/benchmark-test",
    "test/rolldown-test",
    "test/rollup-test",
    "test/webpack-test"
  ]
}
